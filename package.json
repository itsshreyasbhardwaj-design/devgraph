{
  "name": "devgraph",
  "version": "0.1.0",
  "description": "AI-powered interactive software architecture visualization for any codebase",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/itsshreyasbhardwaj-design/devgraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsshreyasbhardwaj-design/devgraph.git"
  },
  "bugs": {
    "url": "https://github.com/itsshreyasbhardwaj-design/devgraph/issues"
  },
  "keywords": [
    "code-visualization",
